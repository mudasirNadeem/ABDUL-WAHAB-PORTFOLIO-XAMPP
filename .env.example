# Neon Postgres connection string (Dashboard > Connection Details > psql).
# sslmode=require is mandatory for Neon.
DATABASE_URL=postgresql://user:password@ep-xxx.region.aws.neon.tech/dbname?sslmode=require

# Secret used to sign the admin JWT cookie. Use a long random string in production.
JWT_SECRET=change-this-to-a-long-random-string

# Admin login for /login and the /admin dashboard.
ADMIN_EMAIL=mudasirnadeem7979@gmail.com
ADMIN_PASSWORD=KHAN123

# Optional: bcrypt hash of the admin password. When set it takes priority
# over ADMIN_PASSWORD and the plaintext value is ignored.
# ADMIN_PASSWORD_HASH=

# development | production. Production also marks the auth cookie as Secure.
NODE_ENV=development
